<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mediatek.neuropilot.jnidemo">

    <uses-permission android:name="mediatek.permission.ACCESS_APU_SYS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/AppTheme">


        <uses-native-library
            android:name="libneuronusdk_adapter.mtk.so"
            android:required="false" />
        <uses-native-library
            android:name="libapu_mdw.so"
            android:required="false" />
        <uses-native-library
            android:name="libapu_mdw_batch.so"
            android:required="false" />
        <uses-native-library
            android:name="libneuron_runtime.so"
            android:required="false" />
        <!-- Expose deps của libapu_mdw.so vào namespace clns-7 -->
        <uses-native-library
            android:name="libbase.so"
            android:required="false" />
        <uses-native-library
            android:name="libc++.so"
            android:required="false" />


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="stateHidden|adjustResize">
        </activity>
        <activity
            android:name="com.bhs.meetingnotes.MeetingNotesActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.bhs.meetingnotes.MeetingRecordActivity" android:screenOrientation="landscape" />
        <activity android:name="com.bhs.meetingnotes.MeetingSelectSegmentsActivity" android:screenOrientation="landscape" />
        <activity android:name="com.bhs.meetingnotes.MeetingProcessingActivity" android:screenOrientation="landscape" />
        <activity android:name="com.bhs.meetingnotes.MeetingResultActivity" android:screenOrientation="landscape" />
        <activity android:name="com.bhs.meetingnotes.MeetingSettingsActivity" android:screenOrientation="landscape" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <service
            android:name="com.bhs.meetingnotes.audio.AudioRecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />


    </application>
</manifest>
