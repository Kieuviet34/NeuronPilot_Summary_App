<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_settings_local"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header Icon + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/fl_dialog_icon_bg"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_badge_delete">

            <ImageView
                android:id="@+id/iv_dialog_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_delete"
                app:tint="@color/red_text" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="Chuyển vào thùng rác?"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Message Description -->
    <TextView
        android:id="@+id/tv_dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="3dp"
        android:text="Cuộc họp sẽ được chuyển vào thùng rác. Bạn có thể xem lại hoặc khôi phục bất kỳ lúc nào."
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        tools:text="Cuộc họp 'Họp Review Sprint Q2' sẽ được chuyển vào thùng rác. Bạn có thể khôi phục lại từ mục Thùng rác." />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_dialog_cancel"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:background="@drawable/bg_circle_gray"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text="Hủy bỏ"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_dialog_confirm"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_badge_delete"
            android:gravity="center"
            android:paddingHorizontal="22dp"
            android:text="Chuyển vào thùng rác"
            android:textColor="@color/red_text"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
