<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_segment_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_segment"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Index Circle -->
    <TextView
        android:id="@+id/tv_segment_index"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_circle_gray"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="01" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_segment_filename"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Hop_BSP_01.wav" />

        <TextView
            android:id="@+id/tv_segment_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="30 phút 15 giây • 28.8 MB • Pause 2 lần" />
    </LinearLayout>

    <!-- Play / Listen Button for Saved Segments -->
    <LinearLayout
        android:id="@+id/btn_play_segment"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_btn_card_detail"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/iv_play_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_play"
            app:tint="@color/blue_primary" />

        <TextView
            android:id="@+id/tv_play_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Nghe lại"
            android:textColor="@color/blue_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Badge status -->
    <TextView
        android:id="@+id/tv_segment_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_saved"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:textColor="@color/green_text"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="Đã lưu" />

</LinearLayout>
