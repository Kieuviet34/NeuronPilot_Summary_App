<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_variant</item>
        <item name="materialButtonStyle">@style/Widget.MeetingNotes.Button</item>
        <item name="materialCardViewStyle">@style/Widget.MeetingNotes.Card</item>
        <item name="chipStyle">@style/Widget.MeetingNotes.Chip</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="alertDialogTheme">@style/Theme.MeetingNotes.Dialog.Alert</item>
    </style>

    <style name="TextAppearance.MeetingNotes" parent="TextAppearance.MaterialComponents.Body1" />

    <style name="TextAppearance.MeetingNotes.Timer">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_timer</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.MeetingNotes.Title">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.MeetingNotes.Section">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_section</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.MeetingNotes.Body">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.MeetingNotes.Caption">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <style name="TextAppearance.MeetingNotes.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>

    <style name="Widget.MeetingNotes.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">@dimen/radius_control</item>
    </style>

    <style name="Widget.MeetingNotes.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/elevation_card</item>
    </style>

    <style name="Widget.MeetingNotes.Chip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="chipBackgroundColor">@color/surface_variant</item>
        <item name="chipCornerRadius">@dimen/radius_pill</item>
        <item name="chipMinHeight">@dimen/touch_min</item>
    </style>

    <!-- Material Dialog Theme for large, prominent buttons and clean text -->
    <style name="Theme.MeetingNotes.Dialog.Alert" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorAccent">@color/blue_primary</item>
        <item name="android:background">@color/bg_card</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.MeetingNotes.Dialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.MeetingNotes.Dialog.Button.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.MeetingNotes.Dialog.Button.Neutral</item>
    </style>

    <!-- Prominent Primary Dialog Action Button: Bold, large touch target, blue background -->
    <style name="Widget.MeetingNotes.Dialog.Button.Positive" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/absolute_white</item>
        <item name="backgroundTint">@color/blue_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- Secondary / Cancel Dialog Button -->
    <style name="Widget.MeetingNotes.Dialog.Button.Negative" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingHorizontal">16dp</item>
    </style>

    <style name="Widget.MeetingNotes.Dialog.Button.Neutral" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingHorizontal">16dp</item>
    </style>
</resources>
